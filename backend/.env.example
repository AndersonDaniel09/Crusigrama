# Variables de entorno para el backend
# Copia este archivo como .env y completa los valores reales

# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crucigrama_db
POSTGRES_USER=crucigrama_user
POSTGRES_PASSWORD=tu_password_seguro

DATABASE_URL=postgresql://crucigrama_user:tu_password_seguro@localhost:5432/crucigrama_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────
# URL del frontend (sin trailing slash)
FRONTEND_URL=http://localhost:5173

# ─── Sesiones ─────────────────────────────────────────────────
# Clave secreta para firmar tokens de sesión de invitados
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_largo
